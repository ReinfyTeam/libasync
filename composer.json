{
    "name": "reinfyteam/libasync",
    "type": "library",
    "description": "Asynchronous runtime and coroutine tools for PocketMine-MP and PHP projects",
    "license": "MIT",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/axolotl-pm/PocketMine-MP",
            "no-api": true
        }
    ],
    "autoload": {
        "psr-4": {
            "libasync\\": "src/libasync",
            "phantom\\": "src/phantom"
        },
        "files": [
            "src/phantom/functions.php",
            "src/libasync/functions.php"
        ]
    },
    "authors": [
        {
            "name": "Blackjack200",
            "email": "lx826444126@gmail.com"
        },
        {
            "name": "ReinfyTeam",
            "email": "reinfyteam@gmail.com"
        }
    ],
    "require": {
        "opis/closure": "^4.3",
        "php": "^8.2"
    },
    "require-dev": {
        "axolotl-pm/pocketmine-mp": "5.49.1",
        "phpstan/phpstan": "^2.3"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "virion": {
            "spec": "3.0",
            "namespace-root": "blackjack200\\libasync"
        }
    }
}
